#!/usr/bin/env bash
# Pre-push hook: runs the same checks as CI before allowing `git push`.
# Skip with `git push --no-verify` for emergencies.
#
# Enable for this clone: `git config core.hooksPath scripts/hooks`
#
# Fast path: only the side(s) (backend/ frontend/) with changes in the push
# range are checked. Changes to scripts/ or .github/ — or an undeterminable
# range — fall back to running everything.
set -uo pipefail

cd "$(git rev-parse --show-toplevel)"

GREEN='\033[0;32m'
RED='\033[0;31m'
DIM='\033[2m'
RST='\033[0m'

failed=0
log_dir="$(mktemp -d)"
trap 'rm -rf "$log_dir"' EXIT

# run_step <dir> <name> <cmd...> — runs <cmd> in <dir>, records pass/fail.
# The subshell scopes only the `cd`; `failed` is set in the parent shell.
run_step() {
  local dir="$1" name="$2"
  shift 2
  local slug log
  slug=$(echo "$name" | tr -c '[:alnum:]' '_')
  log="$log_dir/$slug.log"
  printf "  %-32s " "$name"
  if (cd "$dir" && "$@") >"$log" 2>&1; then
    printf "${GREEN}✓${RST}\n"
  else
    printf "${RED}✗${RST}\n"
    echo "${DIM}--- ${name} output ---${RST}"
    tail -40 "$log"
    echo "${DIM}--- end ---${RST}"
    failed=1
  fi
}

# Decide which sides to check. Default: everything (safe). Narrow only when
# the push range is determinable and touches just one side.
run_backend=1
run_frontend=1
if base=$(git rev-parse --verify --quiet '@{push}' 2>/dev/null); then
  changed="$(git diff --name-only "$base" HEAD 2>/dev/null || true)"
  if [[ -n "$changed" ]]; then
    grep -qE '^backend/' <<<"$changed" && run_backend=1 || run_backend=0
    grep -qE '^frontend/' <<<"$changed" && run_frontend=1 || run_frontend=0
    # A change to the hook / CI config itself → re-check everything.
    if grep -qE '^(scripts/|\.github/)' <<<"$changed"; then
      run_backend=1
      run_frontend=1
    fi
  fi
fi

echo "pre-push: running CI checks (skip with --no-verify)"

if [[ -d backend && $run_backend -eq 1 ]]; then
  echo "backend:"
  run_step backend "ruff format --check" uv run ruff format --check .
  run_step backend "ruff check" uv run ruff check .
  run_step backend "ty check" uvx ty check
  run_step backend "pytest" uv run pytest -q
elif [[ -d backend ]]; then
  printf "backend:  ${DIM}skipped — no backend/ changes${RST}\n"
fi

if [[ -d frontend && $run_frontend -eq 1 ]]; then
  echo "frontend:"
  run_step frontend "tsc --noEmit" npx tsc --noEmit
  run_step frontend "vitest" npx vitest run
  run_step frontend "vite build" npx vite build
elif [[ -d frontend ]]; then
  printf "frontend: ${DIM}skipped — no frontend/ changes${RST}\n"
fi

if [[ $failed -ne 0 ]]; then
  echo
  printf "${RED}pre-push: blocked.${RST} Fix the failures above, or push with ${DIM}--no-verify${RST} to bypass.\n"
  exit 1
fi

echo
printf "${GREEN}pre-push: all checks passed.${RST}\n"
exit 0
