# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.python-version

# Node
node_modules/
dist/
.vite/

# OS
.DS_Store

# Editors
.idea/
.vscode/
# Claude Code session state — per-machine settings + nested-worktree pointers
# kept out of the repo so they don't get committed accidentally during testing.
.claude/

# Local
*.log
ControlRoom.zip
.playwright-mcp/

# Secrets (THI-174, sec:L2) — backend/.env is the documented Anthropic-key
# location; *.pem / *.key / credentials*.json cover the usual incidental
# secret-file shapes so a `git add .` on a dirty tree can't commit them.
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*credentials*.json

# Internal docs — design handoff (prototype JSX/CSS) and per-ticket specs/plans
# stay on local machines but aren't part of the published repo.
docs/design-reference/
docs/superpowers/

# Git worktrees — convention is to keep them under `.worktrees/<branch-tail>/`
# so they're easy to find + clean up. See scripts/wt for the helper.
.worktrees/
